{
  "name": "agentak",
  "version": "0.0.0",
  "description": "Standalone agent chat surface + Chrome extension",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./components": {
      "types": "./dist/components/index.d.mts",
      "default": "./dist/components/index.mjs"
    },
    "./pi": {
      "types": "./dist/agent/index.d.mts",
      "default": "./dist/agent/index.mjs"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @agentak/playground dev",
    "build": "obuild && pnpm --filter @agentak/playground build",
    "build:lib": "obuild",
    "build:extension": "pnpm --filter @agentak/extension build",
    "preview": "pnpm --filter @agentak/playground preview",
    "typecheck": "tsc --noEmit && pnpm --filter @agentak/playground typecheck && tsc --noEmit -p extension",
    "size": "node scripts/bundle.ts",
    "lint": "oxlint",
    "fmt": "oxfmt .",
    "test": "vitest"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.1",
    "@earendil-works/pi-ai": "^0.84.1",
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals": "^2.11.0",
    "md4x": "^0.0.26",
    "preact": "^10.29.8",
    "rangi": "^2.2.0",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@testing-library/preact": "^3.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "obuild": "^0.4.38",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "rolldown": "^1.2.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.21.0"
}
