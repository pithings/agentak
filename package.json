{
  "name": "web-agent",
  "version": "0.0.0",
  "description": "Standalone agent chat web component + Chrome extension",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/lib/web-agent.js",
    "./element": "./dist/lib/element.js",
    "./components": "./dist/lib/components.js",
    "./pi": "./dist/lib/pi.js"
  },
  "scripts": {
    "dev": "pnpm --filter @web-agent/playground dev",
    "build": "vite build --config vite.config.lib.ts && pnpm --filter @web-agent/playground build",
    "build:lib": "vite build --config vite.config.lib.ts",
    "build:extension": "pnpm --filter @web-agent/extension build",
    "preview": "pnpm --filter @web-agent/playground preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p playground && tsc --noEmit -p extension",
    "lint": "oxlint",
    "fmt": "oxfmt .",
    "test": "vitest"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.1",
    "@earendil-works/pi-ai": "^0.84.1",
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals": "^2.11.0",
    "md4x": "^0.0.26",
    "preact": "^10.29.8",
    "rangi": "^2.2.0",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@testing-library/preact": "^3.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.21.0"
}
